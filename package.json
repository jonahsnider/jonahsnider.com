{
	"name": "jonahsnider.com",
	"version": "5.0.0",
	"private": true,
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"type": "module",
	"scripts": {
		"build": "astro check && astro build",
		"dev": "astro dev",
		"format": "oxfmt --check && prettier --check 'src/**/*.astro'",
		"format:fix": "oxfmt && prettier --write 'src/**/*.astro'",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"start": "astro preview"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/rubik": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.4.2",
		"tailwindcss": "4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@types/node": "24.19.2",
		"knip": "6.43.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"typescript": "6.0.3",
		"wrangler": "4.153.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.15.0"
}
