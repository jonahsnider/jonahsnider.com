{
	"name": "jonahsnider.com",
	"version": "5.0.0",
	"private": true,
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"type": "module",
	"scripts": {
		"build": "astro sync && tsc --noEmit --runExternalCode && astro build",
		"dev": "astro dev",
		"format": "oxfmt --check && prettier --check 'src/**/*.astro'",
		"format:fix": "oxfmt && prettier --write 'src/**/*.astro'",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"start": "astro preview"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/rubik": "5.3.0",
		"@tailwindcss/vite": "4.3.5",
		"astro": "7.4.8",
		"tailwindcss": "4.3.5"
	},
	"devDependencies": {
		"@astrojs/ts-content-mapper": "0.2.0",
		"@types/node": "26.6.6",
		"knip": "6.45.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"typescript": "7.1.0-dev.20261110.1",
		"wrangler": "4.160.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
